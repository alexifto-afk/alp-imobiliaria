# Preencha somente no ambiente local ou nas configurações do Render.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/alp
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3001

# Criação inicial do administrador (não executar seed em cada deploy).
ADMIN_CPF=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Recuperação de senha: veja RECUPERACAO-SENHA.md.
RESEND_API_KEY=
RESET_EMAIL_FROM=

# Pix: mantenha suas configurações existentes no Render.
MP_PAYMENTS_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
